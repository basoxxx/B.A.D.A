<?xml version="1.0" encoding="utf-8"?>
<!-- Pressione lunga sull'icona: avvio diretto della registrazione -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_sc_run"
        android:shortcutId="run"
        android:shortcutLongLabel="@string/sc_run_long"
        android:shortcutShortLabel="@string/sc_run">
        <intent
            android:action="app.bada.START_RUN"
            android:targetClass="app.bada.MainActivity"
            android:targetPackage="app.bada" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_sc_bike"
        android:shortcutId="bike"
        android:shortcutLongLabel="@string/sc_bike_long"
        android:shortcutShortLabel="@string/sc_bike">
        <intent
            android:action="app.bada.START_BIKE"
            android:targetClass="app.bada.MainActivity"
            android:targetPackage="app.bada" />
    </shortcut>
</shortcuts>
