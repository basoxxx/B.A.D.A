<?xml version="1.0" encoding="utf-8"?>
<!-- Tutta la pagina scorre; la mappa ha un'altezza fissa e gestisce da sé i gesti -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Titolo: tocco per modificarlo -->
            <TextView
                android:id="@+id/title"
                style="@style/Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAllCaps="false"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Altre azioni"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Nuovo record appena registrato -->
        <TextView
            android:id="@+id/record_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/banner_gold"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <include android:id="@+id/stat_distance" layout="@layout/stat" />
            <include android:id="@+id/stat_time" layout="@layout/stat" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include android:id="@+id/stat_average" layout="@layout/stat" />
            <include android:id="@+id/stat_climb" layout="@layout/stat" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/map_box"
        android:layout_width="match_parent"
        android:layout_height="340dp">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Legenda dei colori della linea -->
        <LinearLayout
            android:id="@+id/legend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/legend_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lento"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <View
                android:id="@+id/legend_bar"
                android:layout_width="56dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Veloce"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/no_points"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@color/surface"
        android:gravity="center"
        android:text="Nessun punto GPS registrato"
        android:textColor="@color/muted"
        android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <app.bada.ChartView
                android:id="@+id/pace_chart"
                android:layout_width="match_parent"
                android:layout_height="140dp" />

            <app.bada.ChartView
                android:id="@+id/alt_chart"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/splits_title"
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Parziali" />

            <LinearLayout
                android:id="@+id/splits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/efforts_title"
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Migliori prestazioni"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/efforts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/share"
                    style="@style/Btn.Primary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Condividi" />

                <Button
                    android:id="@+id/export_gpx"
                    style="@style/Btn.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Esporta GPX" />
            </LinearLayout>
        </LinearLayout>
</LinearLayout>
</ScrollView>
