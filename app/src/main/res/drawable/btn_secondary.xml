<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/border" /><corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="@color/muted" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="@color/border" /></shape>
    </item>
</selector>
